# AI RPG 配置模板（复制此文件为 .env 后填写，请勿在模板中填写真实密钥）
# LLM 服务地址（OpenAI 兼容接口，默认官方）
LLM_BASE_URL=https://api.openai.com/v1
# API Key（必填）
LLM_API_KEY=
# 模型名称（默认 gpt-4o-mini）
LLM_MODEL=gpt-4o-mini
# 服务端口（后端监听端口，前端通过 Vite 代理访问，一般无需改动）
PORT=3001
# 前端来源（CORS 允许的源）。开发模式下前端走 Vite 代理（浏览器只与 5173 同源通信），
# 不触发 CORS，此配置并非必需；仅在前端绕过代理、浏览器直连后端端口时生效
FRONTEND_ORIGIN=http://localhost:5173
# 访问口令（可选）：配置后所有 /api 请求必须带 X-Access-Token 头；留空则不校验（本地开发）
# 部署到公网时务必设置一个足够随机的口令，例如：ACCESS_TOKEN=Kf7pX9q2mZ
ACCESS_TOKEN=

# 管理员名单（可选）：逗号分隔的用户名，服务启动时同步标记到数据库（is_admin）。
# 名单中的用户登录后可访问管理后台（用户管理、会话查看等）；留空则无人拥有管理权限
ADMIN_USERNAMES=
# —— AI 插画（可选，推理杀终局主题图与角色立绘）——
# 图像生成接口地址（独立于 LLM 接口；SenseNova 图像服务）
IMAGE_BASE_URL=https://token.sensenova.cn/v1
# 图像服务 API Key（留空则复用 LLM_API_KEY）
IMAGE_API_KEY=
# 图像模型名称（留空则不启用插画，游戏不受影响）；例如：sensenova-u1.5-fast
IMAGE_MODEL=
